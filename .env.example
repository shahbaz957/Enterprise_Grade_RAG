# App
APP_NAME=AskPod
APP_VERSION=0.1.0
DEBUG=false
API_PREFIX=/api/v1
BACKEND_URL=http://localhost:8000
# CORS_ORIGINS is JSON list if overridden, e.g. ["http://localhost:3000"]

# Auth (non-local): Bearer RAG_API_KEY or HS256 JWT (RAG_JWT_SECRET)
# When DEBUG=false and RAG_API_KEY is set, /query and /sessions* require auth.
# Force always on with RAG_AUTH_REQUIRED=true. Next.js proxy sends the key server-side.
RAG_API_KEY=
RAG_JWT_SECRET=
RAG_AUTH_REQUIRED=false

# Rate limit — Upstash Redis REST in cloud; in-memory when unset
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_WINDOW_SECONDS=60

# OpenAI (embeddings and/or chat)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
EMBEDDING_DIMENSIONS=1536

# Groq (inference) — used when USE_OPENAI_LLM=false, and as Portkey fallback
GROQ_API_KEY=
GROQ_FALLBACK_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# Optional dedicated Groq key for RAGAS when USE_OPENAI_LLM=false
JUDGE_GROQ_API_KEY=

# true = OpenAI for guardrails / RAGAS judge / direct LLM
# false = Groq for those (old default)
# Portkey agent routing is separate (PRIMARY/FALLBACK VKs below).
USE_OPENAI_LLM=true

# Portkey gateway — OpenAI primary, Groq fallback
PORTKEY_ENABLED=true
PORTKEY_API_KEY=
PORTKEY_VIRTUAL_KEY=                 # legacy single VK (used as primary if PRIMARY empty)
PORTKEY_VIRTUAL_KEY_PRIMARY=         # OpenAI virtual key slug
PORTKEY_VIRTUAL_KEY_FALLBACK=        # Groq virtual key slug
# Required for fallback/cache when Portkey blocks inline config (error: inline_config_blocked).
# Generate JSON: uv run python -m app.scripts.print_portkey_config → paste in Portkey dashboard.
PORTKEY_CONFIG_ID=                   # pc-... saved Config ID
PORTKEY_ALLOW_INLINE_CONFIG=false    # keep false unless your org allows inline JSON configs
PORTKEY_STRATEGY=fallback            # fallback | loadbalance (used when building dashboard JSON)
PORTKEY_PRIMARY_WEIGHT=0.7
PORTKEY_FALLBACK_WEIGHT=0.3
PORTKEY_CACHE_MODE=simple            # off | simple | semantic
PORTKEY_CACHE_MAX_AGE=3600
PORTKEY_RETRY_ATTEMPTS=3
PORTKEY_TIMEOUT_MS=30000
PORTKEY_ENVIRONMENT=dev

# Jina reranker
JINA_API_KEY=
JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual
JINA_RERANK_TOP_N=15

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_CLUSTER_ENDPOINT=
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_rag

# Observability
LOGFIRE_TOKEN=
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Neon Postgres (chat session memory — messages only)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# NeMo Guardrails (local Colang under app/guardrails/config — no NVIDIA account)
# Reuses GROQ_API_KEY or OPENAI_API_KEY for self-check / intent confirm.
GUARDRAILS_ENABLED=true
GUARDRAILS_CONFIG_PATH=app/guardrails/config
# Fail open only for local debugging; production should stay false (fail closed).
GUARDRAILS_FAIL_OPEN=false
# Pre-load NeMo guardrails + agent graph when uvicorn starts (recommended).
WARMUP_ON_STARTUP=true
