# App
APP_NAME=Enterprise RAG Backend
APP_VERSION=0.1.0
DEBUG=false
API_PREFIX=/api/v1
BACKEND_URL=http://localhost:8000
# CORS_ORIGINS is JSON list if overridden, e.g. ["http://localhost:3000"]

# OpenAI (embeddings and/or chat)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
EMBEDDING_DIMENSIONS=1536

# Groq (inference)
GROQ_API_KEY=
GROQ_FALLBACK_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# Separate key for RAGAS judge LLM (recommended so evals don't starve the agent)
JUDGE_GROQ_API_KEY=

# Portkey gateway (LLM fault tolerance — no provider keys needed in app code once VKs exist)
# 1) Create API key + Virtual Keys in https://app.portkey.ai (Groq primary, OpenAI fallback)
# 2) Fill slugs below. Agent chat then routes: primary → fallback, with retries/cache.
PORTKEY_ENABLED=true
PORTKEY_API_KEY=
PORTKEY_VIRTUAL_KEY=                 # legacy single VK (used as primary if PRIMARY empty)
PORTKEY_VIRTUAL_KEY_PRIMARY=         # Groq virtual key slug
PORTKEY_VIRTUAL_KEY_FALLBACK=        # OpenAI virtual key slug
PORTKEY_CONFIG_ID=                   # optional: saved Config ID overrides inline JSON
PORTKEY_STRATEGY=fallback            # fallback | loadbalance
PORTKEY_PRIMARY_WEIGHT=0.7
PORTKEY_FALLBACK_WEIGHT=0.3
PORTKEY_CACHE_MODE=simple            # off | simple | semantic
PORTKEY_CACHE_MAX_AGE=3600
PORTKEY_RETRY_ATTEMPTS=3
PORTKEY_TIMEOUT_MS=30000
PORTKEY_ENVIRONMENT=dev

# Jina reranker
JINA_API_KEY=
JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual
JINA_RERANK_TOP_N=15

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_CLUSTER_ENDPOINT=
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_rag

# Observability
LOGFIRE_TOKEN=
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Neon Postgres (chat session memory — messages only)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# NeMo Guardrails (local Colang under app/guardrails/config — no NVIDIA account)
# Reuses GROQ_API_KEY or OPENAI_API_KEY for self-check / intent confirm.
GUARDRAILS_ENABLED=true
GUARDRAILS_CONFIG_PATH=app/guardrails/config
# Fail open only for local debugging; production should stay false (fail closed).
GUARDRAILS_FAIL_OPEN=false
